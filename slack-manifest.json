{
  "display_information": {
    "name": "Symentic",
    "description": "Symentic is your autonomous AI infrastructure — deploy agents that observe, act, and evolve across Slack, Discord, APIs, and beyond.",
    "background_color": "#3d3c3d",
    "long_description": "Symentic is an intelligent platform that deploys AI agents to automate workflows, manage bugs, schedule meetings, maintain team profiles, and integrate with your entire tech stack. Our agents observe conversations, take actions, and continuously learn to better serve your team."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Symentic",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Report a Bug",
        "type": "global",
        "callback_id": "report_bug",
        "description": "Quickly report a bug"
      }
    ],
    "slash_commands": [
      {
        "command": "/refresh-profile",
        "url": "https://x9tw492kl2.execute-api.us-east-1.amazonaws.com/prod/slack/events",
        "description": "Refresh your profile engram",
        "usage_hint": "[no parameters needed]",
        "should_escape": false
      },
      {
        "command": "/sync-workspace",
        "url": "https://x9tw492kl2.execute-api.us-east-1.amazonaws.com/prod/slack/events",
        "description": "Sync all workspace profiles (admin only)",
        "usage_hint": "[--force to bypass rate limit]",
        "should_escape": false
      },
      {
        "command": "/link-bugs",
        "url": "https://x9tw492kl2.execute-api.us-east-1.amazonaws.com/prod/slack/events",
        "description": "Link two related bugs together",
        "usage_hint": "[bug-number-1] [bug-number-2]",
        "should_escape": false
      },
      {
        "command": "/connect-calendar",
        "url": "https://x9tw492kl2.execute-api.us-east-1.amazonaws.com/prod/slack/events",
        "description": "Connect your Google Calendar for meeting scheduling",
        "usage_hint": "[no parameters needed]",
        "should_escape": false
      },
      {
        "command": "/disconnect-calendar",
        "url": "https://x9tw492kl2.execute-api.us-east-1.amazonaws.com/prod/slack/events",
        "description": "Disconnect your Google Calendar",
        "usage_hint": "[no parameters needed]",
        "should_escape": false
      }
    ]
  },
