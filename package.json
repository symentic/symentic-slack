{
  "name": "symentic-slack",
  "version": "1.0.0",
  "description": "Master AI agent Slack bot for Symentic platform",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:lambdas && npm run build:infra",
    "build:core": "npm run build -w @symentic/core",
    "build:lambdas": "npm run build -w @symentic/lambdas",
    "build:infra": "npm run build -w @symentic/infrastructure",
    "clean": "npm run clean -ws",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "cdk": "npm run cdk -w @symentic/infrastructure",
    "cdk:synth": "npm run synth -w @symentic/infrastructure",
    "cdk:deploy": "npm run deploy -w @symentic/infrastructure",
    "cdk:deploy:prod": "npm run deploy:prod -w @symentic/infrastructure",
    "cdk:destroy": "npm run destroy -w @symentic/infrastructure",
    "cdk:diff": "npm run diff -w @symentic/infrastructure",
    "update-slack-manifest": "ts-node scripts/update-slack-manifest.ts"
  },
  "keywords": [
    "slack",
    "bot",
    "ai",
    "agent",
    "aws",
    "lambda"
  ],
  "author": "Symentic",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.848.0",
    "@aws-sdk/lib-dynamodb": "^3.848.0",
    "@codegenie/serverless-express": "^4.17.0",
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.9.3",
    "aws-sdk": "^2.1547.0",
    "axios": "^1.11.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "googleapis": "^153.0.0",
    "openai": "^5.10.1",
    "redis": "^5.6.0",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@aws-cdk/assert": "^2.68.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "aws-cdk-lib": "^2.206.0",
    "constructs": "^10.4.2",
    "eslint": "^9.31.0",
    "jest": "^30.0.5",
    "serverless": "^4.17.1",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-plugin-typescript": "^2.1.5",
    "serverless-step-functions": "^3.23.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.0"
  }
}
