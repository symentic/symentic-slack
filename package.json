    "aws-sdk": "^2.1547.0",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "googleapis": "^134.0.0",
    "openai": "^4.47.1",
    "redis": "^4.6.13",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.134",
