{
  "name": "@symentic/infrastructure",
  "version": "1.0.0",
  "description": "CDK infrastructure for Symentic Slack Bot",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist cdk.out",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:dev": "cdk deploy --all --require-approval never --context stage=${CDK_STAGE:-dev-$USER}",
    "deploy:prod": "cdk deploy --all --require-approval never --context stage=prod",
    "diff:dev": "cdk diff --all --context stage=${CDK_STAGE:-dev-$USER}",
    "diff:prod": "cdk diff --all --context stage=prod",
    "destroy": "cdk destroy --all --force",
    "destroy:dev": "cdk destroy --all --force --context stage=${CDK_STAGE:-dev-$USER}",
    "diff": "cdk diff"
  },
  "dependencies": {
    "@symentic/core": "1.0.0",
    "@symentic/lambdas": "1.0.0",
    "aws-cdk-lib": "^2.206.0",
    "constructs": "^10.4.2",
    "dotenv": "^17.2.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "aws-cdk": "^2.1021.0",
    "esbuild": "^0.25.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  }
}
